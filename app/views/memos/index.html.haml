.mx-auto.max-w-3xl.px-4.py-12
  .flex.items-center.justify-between.mb-8
    %h1.text-2xl.font-bold.text-gray-900 メモ一覧
    .flex.items-center.gap-4
      = link_to 'CSV エクスポート', memos_path(format: :csv), class: 'inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500'
      = button_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'text-sm text-gray-500 hover:text-gray-700 cursor-pointer'
  .mb-8.rounded-lg.bg-white.p-6.shadow-sm.border.border-gray-200
    %h3.text-sm.font-semibold.text-gray-700.mb-3 CSVインポート
    = form_with url: import_memos_path, method: :post, multipart: true, class: 'flex items-center gap-4' do |f|
      = f.file_field :file, accept: '.csv', class: 'block text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100'
      = f.submit 'インポート', class: 'inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 cursor-pointer'
  - if @memos.any?
    .space-y-4
      - @memos.each do |memo|
        .rounded-lg.bg-white.p-6.shadow-sm.border.border-gray-200.hover:shadow-md.transition-shadow
          %h2.text-lg.font-semibold.text-gray-900= memo.title
          %p.mt-2.text-sm.text-gray-600.line-clamp-3= memo.body
          %time.mt-3.block.text-xs.text-gray-400= l(memo.created_at, format: :short)
  - else
    .rounded-lg.bg-white.p-12.text-center.shadow-sm.border.border-gray-200
      %p.text-gray-500 メモはまだありません。
